# MANASARA — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your project's public anon key (safe to expose to the browser with RLS enabled)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=MANASARA
VITE_APP_URL=http://localhost:3000

# ── Edge Function secrets (set via Supabase CLI, NOT here) ───────────────────
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# supabase secrets set RATE_LIMIT_MAX_REQUESTS=10
# supabase secrets set RATE_LIMIT_WINDOW_MS=60000
